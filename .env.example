# Copie este arquivo para .env.local no seu PC.
# Nunca coloque credenciais reais neste arquivo versionado.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Banco/autenticacao: permanecem vazios ate a etapa de Supabase/PostgreSQL.
# Use apenas valores do ambiente de desenvolvimento local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# Backend somente. Nunca expor no frontend e nunca commitar valor real.
SUPABASE_SERVICE_ROLE_KEY=
