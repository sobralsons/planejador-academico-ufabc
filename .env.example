# Copie este arquivo para .env.local no seu PC.
# Nunca coloque credenciais reais neste arquivo versionado.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Banco/autenticacao local. Nunca coloque chaves reais neste arquivo versionado.
# Em desenvolvimento, SUPABASE_URL deve apontar apenas para localhost/127.0.0.1.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade com stacks locais antigos. Prefira SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=
DATABASE_URL=

# Backend somente. Nunca expor no frontend e nunca commitar valor real.
SUPABASE_SERVICE_ROLE_KEY=
